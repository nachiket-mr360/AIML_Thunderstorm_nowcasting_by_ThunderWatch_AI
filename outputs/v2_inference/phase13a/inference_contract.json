      "model_type": "RandomForestClassifier",
      "n_features": 83,
      "target": "target_2h",
      "threshold": 0.065,
      "random_state": 42
    },
    "target_3h": {
      "artifact_path": "models/v2/nwp_experiment/B_atmospheric_nwp_target_3h.joblib",
      "metrics_path": "outputs/v2_nwp_experiment/metrics_B_atmospheric_nwp_target_3h.json",
      "model_type": "RandomForestClassifier",
      "n_features": 83,
      "target": "target_3h",
      "threshold": 0.065,
      "random_state": 42
    }
  },
  "thresholds": {
    "1h": 0.065,
    "2h": 0.065,
    "3h": 0.065,
    "source": "Phase 8D Model B validation F2 with alert-rate cap 0.20; frozen; not re-optimized in 13A"
  },
  "output_schema": [
    "prediction_timestamp_utc",
    "station_id",
