{
  "phase": "13A",
  "status": "research_prototype_contract",
  "production": false,
  "model_version": "V2-MODEL-B-MULTILEAD-PHASE8D-RESEARCH",
  "architecture": "Model B: atmospheric + location/temporal + NWP",
  "n_model_features": 83,
  "random_state": 42,
  "model_type": "sklearn.ensemble.RandomForestClassifier",
  "training_configuration": {
    "n_estimators": 200,
    "criterion": "gini",
    "max_features": "sqrt",
    "class_weight": "balanced",
    "random_state": 42,
    "n_jobs": -1,
    "sklearn_version_trained": "1.6.1",
    "complete_case_nwp": true,
    "imputation": false,
    "script": "ml/train_v2_nwp_experiment_phase8d.py"
  },
  "alert_rule": "lead_Xh_alert = 1 iff lead_Xh_probability >= threshold_Xh; else 0",
  "probability_semantics": "RandomForest predict_proba[:, 1] positive-class score. Not a calibrated statistical confidence interval.",
  "temporal_rule": {
    "prediction_time": "T",
    "predictors_must_be_available_at_or_before": "T",
    "forbidden_as_predictors": ["T+1 observations", "T+2 observations", "T+3 observations"],
    "future_targets_are_labels_only": true,
    "nwp_valid_time": "same UTC hour T as observation (Phase 8B nwp_time_shift=false)"
  },
  "required_input_identity": ["station_id", "timestamp_utc"],
  "stations": ["VOTV", "VECC", "VIDP", "VOCI", "VABB"],
  "frozen_artifacts": {
    "target_1h": {
      "artifact_path": "models/v2/nwp_experiment/B_atmospheric_nwp_target_1h.joblib",
      "metrics_path": "outputs/v2_nwp_experiment/metrics_B_atmospheric_nwp_target_1h.json",
      "model_type": "RandomForestClassifier",
      "n_features": 83,
      "target": "target_1h",
      "threshold": 0.065,
      "random_state": 42
    },
    "target_2h": {
      "artifact_path": "models/v2/nwp_experiment/B_atmospheric_nwp_target_2h.joblib",
